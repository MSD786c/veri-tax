# Live demo, fully on-prem: local OCR (PDF text layer, PaddleOCR for scans) + every AI agent on a local Ollama model.
# No API key, no external AI call: invoice data never leaves this machine. scripts/start_demo.sh creates the model
# (ollama/veritax-vat.Modelfile) on first run. Run with: uv run --env-file .env.demo ...
AGENT_PROVIDER=local
LOCAL_OCR=1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=veritax-vat:7b
VISION_MODEL=veritax-vat:7b
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=300
