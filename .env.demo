# Live demo: reading is local (PaddleOCR on every page; LOCAL_OCR=1 uses the PDF text layer when present); a Gemini lite model
# turns that text into invoice fields. Uses GEMINI_API_KEY from .env. Run with: uv run --env-file .env.demo ...
AGENT_PROVIDER=local
LOCAL_OCR=paddle
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
VISION_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=4000
