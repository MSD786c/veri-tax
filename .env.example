# SQLite by default; swap for Postgres e.g. postgresql+psycopg://user:pass@host/veritax
DATABASE_URL=sqlite:///./veritax.db
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Load synthetic fixtures on startup when the DB is empty
SEED=1
# Key for the keyed hash of Emirates IDs. Set a long random value outside local development.
ID_HASH_KEY=dev-only-change-me
# Reasoning agent provider (OCR + second opinion on REVIEW items). Leave empty: not wired yet, see app/agent.py
AGENT_PROVIDER=
