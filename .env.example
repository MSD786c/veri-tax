# SQLite by default; swap for Postgres e.g. postgresql+psycopg://user:pass@host/veritax
DATABASE_URL=sqlite:///./veritax.db
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Load synthetic fixtures on startup when the DB is empty
SEED=1
# Key for the keyed hash of Emirates IDs. Set a long random value outside local development.
ID_HASH_KEY=dev-only-change-me
# Reasoning agent (OCR extraction, second opinions, decision briefs). "groq" or empty (no agent). See app/agent.py
AGENT_PROVIDER=groq

# --- Groq (OpenAI-compatible). Never commit the real key: put it in .env only. ---
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Must accept images. Check GET /health/llm for what your key can see.
VISION_MODEL=qwen/qwen3.8-27b
# Output cap per call. Groq on-demand allows 1000 output tokens/min, so keep this < 1000.
LLM_MAX_TOKENS=700

# --- Maskan portal (invoice intake) ---
DATA_DIR=./data
# Secret path for /maskan/portal/<token>. Leave empty to auto-generate into DATA_DIR.
MASKAN_PORTAL_TOKEN=
